{
  "name": "Communitybanlist",
  "version": "1.0.2",
  "repository": "https://github.com/community-ban-list/Communitybanlist.git",
  "author": "Community Ban List https://github.com/community-ban-list",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "ban-importer",
    "client",
    "discord-bot",
    "scbl-lib",
    "web-server"
  ],
  "scripts": {
    "prepare": "husky || true",
    "lint": "eslint --fix . && prettier --write \"./**/*.{js,jsx,mjs}\"",
    "prettier": "prettier --write \"./**/*.{js,jsx,mjs}\"",
    "start-ban-importer": "node ban-importer/index.js",
    "start-discord-bot": "node discord-bot/index.js",
    "build-web-server": "cd client && npm run build",
    "start-web-server": "cross-env NODE_ENV=production node web-server/index.js",
    "dev-web-server": "conc \"nodemon --ignore './client/' web-server/index.js\" \"cd client && npm run start\"",
    "docker-build-web-server": "docker build -f ./web-server/Dockerfile . -t cblweb-dev",
    "docker-build-ban-importer": "docker build -f ./ban-importer/Dockerfile . -t cblimporter-dev",
    "docker-build-discord-bot": "docker build -f ./discord-bot/Dockerfile . -t cblbot-dev",
    "prod-test": "conc \"yarn docker-build-web-server\" \"yarn docker-build-ban-importer\" \"yarn docker-build-discord-bot\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "neostandard": "^0.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "react-step-wizard": "^5.3.5",
    "simple-discord-webhooks": "^2.1.0"
  }
}
